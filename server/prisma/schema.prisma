generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Enums for Data Integrity ---
enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum Status {
  ACTIVE
  UNDER_REVIEW
  ON_LEAVE
  TERMINATED
}

enum Urgency {
  HIGH
  MEDIUM
  LOW
}

enum TaskType {
  REVIEW
  PERFORMANCE
  APPROVAL
}

// --- Models ---

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  role       Role      @default(EMPLOYEE)
  employeeId Int?      @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])
}

model Employee {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  role             Role
  department       String
  performanceScore Float
  status           Status            @default(ACTIVE)
  joinDate         DateTime
  avatar           String
  location         String

  // Self-relation for hierarchy
  managerId        Int?
  manager          Employee?         @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates     Employee[]        @relation("ManagerSubordinates")

  // Relation to User
  user             User?

  // Relation to Tasks
  tasks            Task[]

  // Supervisor notes written about this employee
  supervisorNotes  SupervisorNote[]
}

model SupervisorNote {
  id         Int      @id @default(autoincrement())
  employeeId Int
  author     String
  note       String
  createdAt  DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Task {
  id             Int       @id @default(autoincrement())
  title          String
  status         String    @default("PENDING")
  actionType     String    @default("review")
  reason         String?
  priority       String?   @default("medium")
  dueDate        DateTime
  urgency        Urgency   @default(MEDIUM)
  type           TaskType  @default(REVIEW)
  score          Float?
  department     String?
  initiatedBy    String?   @default("HR Manager")
  initiatorRole  String?   @default("Human Resources")
  decidedBy      String?
  decidedDate    DateTime?
  decisionNotes  String?
  supportingDocs String?
  createdAt      DateTime  @default(now())

  // Relation to Employee
  employeeId     Int
  assignedTo     Employee  @relation(fields: [employeeId], references: [id])
}

model InboxMessage {
  id         Int      @id @default(autoincrement())
  sender     String
  senderRole Role
  content    String
  time       DateTime @default(now())
  unread     Boolean  @default(true)
  avatar     String
}

model CalendarEvent {
  id        Int      @id @default(autoincrement())
  title     String
  type      String
  eventDate DateTime
  attendee  String?
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HRSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique @default("global")
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}